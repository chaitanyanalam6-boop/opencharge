# Copy to .env and fill in. Never commit .env.

# LLM provider (Phase 4)
GROQ_API_KEY=

# Database. Local dev uses a DuckDB file; deployment uses Postgres.
DATABASE_URL=duckdb:///data/opencharge.duckdb

# Sent in the User-Agent on every fetch so hospitals can reach us (brief §7.6).
OPENCHARGE_CONTACT_EMAIL=

# API (Phase 5)
ALLOWED_ORIGINS=http://localhost:5173
# Set to 1 only behind a proxy that sets X-Forwarded-For (Railway); used for rate limiting.
TRUST_PROXY=0
